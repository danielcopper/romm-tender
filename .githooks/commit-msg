#!/usr/bin/env bash
# Run the developer's global commit-msg hook, if they have one, with the same
# arguments and stdin, and adopt its verdict. core.hooksPath points at this
# directory, which switches the global hooks off in this repo; the full
# rationale is in .githooks/pre-commit ("Chain the developer's global
# pre-commit"). A developer with no global hook notices nothing, and a global
# hooksPath that is this directory itself does not make the hook call itself.
global_hooks=$(git config --global --type=path --get core.hooksPath)
if [ -n "${global_hooks:-}" ] && [ -x "$global_hooks/commit-msg" ] &&
    ! [ "$global_hooks/commit-msg" -ef "$0" ]; then
    exec "$global_hooks/commit-msg" "$@"
fi
