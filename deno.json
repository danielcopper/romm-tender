{
  "fmt": {
    "include": ["**/*.md"],
    // docs/assets is excluded as well as being outside the md include: passing an
    // explicit path (deno fmt docs/) overrides include but still honours exclude,
    // and deno fmt treats SVG as markup — it has re-expanded the minified logo.
    // The resolver's recorded machines are a verbatim copy, upstream's README included.
    "exclude": [
      "CHANGELOG.md",
      "site/",
      "node_modules/",
      ".claude/worktrees/",
      ".worktrees/",
      "docs/assets",
      "tests/adapters/atlas_vectors/vectors/"
    ],
    "proseWrap": "always",
    "lineWidth": 120
  }
}
